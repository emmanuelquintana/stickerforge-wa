# Vacío = solo chat contigo mismo. Añade JIDs exactos de personas de confianza.
# Ejemplo: 521XXXXXXXXXX@s.whatsapp.net,123456789@lid
ALLOWED_JIDS=
SESSION_DIR=session
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Desactiva todas las descargas por URL con ENABLE_LINKS=0.
ENABLE_LINKS=1
# Enable only when an external network sandbox restricts yt-dlp to public addresses.
# ENABLE_UNISOLATED_EXTRACTORS=1
